---
const SKILLS = [
    { src: "/images/javascript.png", label: "JavaScript" },
    { src: "/images/typescript.png", label: "TypeScript" },
    { src: "/images/skills/nodejs.svg", label: "Node.js" },
    { src: "/images/skills/nestjs.svg", label: "NestJS" },
    { src: "/images/skills/express.svg", label: "Express", light: true },
    { src: "/images/python.png", label: "Python" },
    { src: "/images/react.png", label: "React / React Native" },
    { src: "/images/next.png", label: "Next.js", light: true },
    { src: "/images/skills/tailwind.svg", label: "Tailwind" },
    { src: "/images/postgresql.png", label: "PostgreSQL" },
    { src: "/images/mongodb.png", label: "MongoDB" },
    { src: "/images/skills/prisma.svg", label: "Prisma", light: true },
    { src: "/images/skills/docker.svg", label: "Docker" },
    { src: "/images/skills/aws.svg", label: "AWS", light: true },
    { src: "/images/skills/microservices.svg", label: "Microservices" },
    { src: "/images/skills/ai.svg", label: "AI / LLMs" },
    { src: "/images/skills/ml.svg", label: "Machine Learning" },
    { src: "/images/git.png", label: "Git" },
]
---

<div class="pt-10">
    <h2 class="text-2xl text-center pb-6">My skills</h2>

    <ul class="flex gap-x-5 gap-y-6 justify-center flex-wrap max-w-[600px] mx-auto">
        {SKILLS.map(({ src, label, light }) => (
            <li class="group flex flex-col items-center gap-2 w-16 lg:w-20" title={label}>
                <span class={`flex items-center justify-center size-11 lg:size-14 rounded-xl border border-white/10 transition group-hover:scale-110 ${light ? "bg-white p-1.5" : "bg-white/5 p-2"}`}>
                    <img src={src} alt={label} class="size-full object-contain" loading="lazy" />
                </span>
                <span class="text-[11px] lg:text-xs text-center text-white/70 leading-tight">{label}</span>
            </li>
        ))}
    </ul>
</div>
