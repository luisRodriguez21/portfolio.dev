---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCIE = [
  {
    date: "Mar. 2023 - Present",
    title: "TROBBU | Senior Backend Developer",
    description: "Backend for a fractional ownership, booking and hospitality platform. I build and maintain the API with Node.js, Express and PostgreSQL, design data models for the business modules and the admin panel, integrate third-party services (payments, messaging, email and push notifications), add AI-powered features, and deploy across development, staging and production environments. I also contribute to the features consumed by the mobile app.",
  },
  {
    date: "Aug. 2026 - Sep. 2026",
    title: "BdocOne | Backend Developer (Freelance)",
    description: "Backend for a healthcare platform to manage medical appointments: REST API in TypeScript, Node.js and PostgreSQL with role-based authentication, automated reminders and notifications, deployed to the cloud.",
  },
  {
    date: "Jan. 2020 - Feb. 2023",
    title: "Softiux | Full Stack Developer",
    description: "Web components and landing pages with React and JavaScript, and backend features with Laravel, Node.js, Python and Java following MVC. Managed MySQL, SQL Server and Oracle databases, contributed to an internal mobile app with React Native, and worked on a workplace survey platform for Great Place to Work®.",
  },
  {
    date: "Aug. 2021 - Dec. 2021",
    title: "UTSEM | Web Developer",
    description: "Implemented new modules in a Laravel CRM and migrated the application to a newer Laravel version.",
  },
  {
    date: "Feb. 2019 - Dec. 2019",
    title: "Nutrición del Campo | Web Developer",
    description: "Interactive kiosk built with HTML, CSS, JavaScript, jQuery and Unity renders, plus the company landing page in WordPress.",
  },
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCIE.map((experiencie) => (
      	<li class="mb-10 ms-4">
        	<ExperienceItem {...experiencie} />
      	</li>
    ))
  }
</ol>
